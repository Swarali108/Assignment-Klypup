# OpenRouter Chat Completions (tools/llm.py defaults to this URL). The key stays in this file, never in code.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Cheap model for extraction and briefs. It must have a rate in PRICES in tools/llm.py.
LLM_MODEL=anthropic/claude-haiku-5.5
# Stronger model, used only for identity pairs that code cannot settle.
LLM_MODEL_STRONG=anthropic/claude-sonnet-5.5
# Optional: the password that shows the app's Run button and new-event form. Left blank, both stay hidden.
APP_PASSWORD=
# Optional: worker processes for reading long PDFs (default 8). A small host can use 2.
MAX_WORKERS=
# Optional: set per run to group cost rows. Left blank, run.py makes one from the event and the time.
RUN_ID=

# Optional. Postgres (e.g. Neon) for users, call notes and chat; unset = SQLite at api/state/app.sqlite.
# Neon: use the pooled URL (host contains -pooler); the app needs no prepared statements.
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Locally a secret is generated into api/state/ when unset. Required (32+ characters) when APP_ENV=production.
# SESSION_SECRET=

# Deployment only (docs/DEPLOYMENT.md). Unset locally.
# APP_ENV=production               # refuse to start without SESSION_SECRET
# HOST=0.0.0.0                     # python -m api binds here (default 127.0.0.1)
# PORT=8000                        # Railway injects PORT; python -m api listens on it
# ALLOWED_ORIGINS=https://finsight.vercel.app,https://finsight.example.com   # origins allowed to write; default the local web app
# COOKIE_SECURE=1                  # 1 always Secure, 0 never; unset = Secure when the request came over https
# DATA_DIR=/data                   # a mounted volume: outputs/, events/, cache/, api/state and cost_log.csv live there
# DEMO_ACCOUNTS=1                  # production only: also offer the rm/head/viewer/new-RM demo accounts (password demo1234), never the admin
# Web app (web/, Vercel): where the API is. Read at build time for the /api rewrite, so redeploy after changing it.
# API_ORIGIN=https://finsight-api-production.up.railway.app

# Bright Data (LinkedIn profile + search results for deep dives). Token only; never the account email/password.
BRIGHTDATA_API_TOKEN=
# Stop before the free monthly allowance runs out (requests counted locally).
BRIGHTDATA_REQUEST_CAP=4500
# on | off. Public professional fields only; no contact details are ever stored.
LINKEDIN_ENRICHMENT=on

# NSE/BSE connectors (tools/exchanges): on|off. Against the sites' terms; owner's call (see config/sources.py).
EXCHANGE_SOURCES=on
